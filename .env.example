# =====================================================================
# AI-Powered Smart Classroom AV Troubleshooting Assistant Configuration
# =====================================================================

# Server & Application
APP_TITLE="AI-Powered Smart Classroom AV Troubleshooting Assistant"
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# Database Configuration (SQLite default with clean PostgreSQL migration readiness)
DATABASE_URL=sqlite:///data/classroom_av.db

# LLM Configuration (Qwen3-8B)
HF_MODEL_ID=Qwen/Qwen3-8B
FORCE_LOCAL_TRANSFORMERS=false

# Optional OpenAI-Compatible Serving Endpoint for Qwen3-8B (Ollama, vLLM, LM Studio)
# Default: Automatically probes http://127.0.0.1:11434/v1, http://127.0.0.1:8000/v1, http://127.0.0.1:1234/v1
# If no endpoint is configured or reachable, falls back to grounded ChromaDB synthesis.
QWEN_ENDPOINT_URL=http://127.0.0.1:11434/v1
QWEN_MODEL_NAME=qwen3-8b
QWEN_API_KEY=optional_api_key_if_secured

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=classroom_av_manuals

# Optional Twilio Voice & SMS Configuration (Leave blank to use In-App notifications only)
# Never hard-code production credentials here.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
ADMIN_NOTIFICATION_PHONE=your_admin_destination_phone_here

# Public Support Datasets
PUBLIC_DATASETS_CACHE_DIR=data/public_datasets
